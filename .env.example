# Copy this file to .env and fill in your real key. Never commit .env itself.
# Free — get one at https://console.groq.com (no credit card required).
GROQ_API_KEY=your-groq-api-key

# Optional: which Groq model to use. qwen/qwen3.8-27b is available on current accounts
# for SQL generation and insight writing. See https://console.groq.com/docs/models
GROQ_MODEL=qwen/qwen3.8-27b

# Optional: override the default SQLite DB path used by ai/ask_data.py and the app
RETAIL_DB_PATH=data/processed/retail.db
